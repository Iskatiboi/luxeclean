---
import { site } from "../site.config";
import MobileNav from "./MobileNav.tsx";
import { url } from "../lib/url";

const path = Astro.url.pathname;
const isActive = (href: string) => (href === "/" ? path === "/" : path.startsWith(href));
const navItems = site.nav.slice(1).map((item) => ({ ...item, href: url(item.href) }));
---

<div class="fixed inset-x-0 top-0 z-30 flex justify-center px-3 pt-3 md:px-4 md:pt-4">
  <header
    class="flex w-full max-w-6xl items-center justify-between rounded-full bg-surface px-6 py-3 shadow-[0_8px_30px_rgba(23,19,15,0.12)] md:px-8"
  >
    <a href={url("/")} class="flex flex-col leading-none">
      <span class="font-heading text-lg tracking-tight text-ink md:text-xl">Luxury</span>
      <span class="mt-1 font-body text-[9px] uppercase tracking-[0.3em] text-ink/55 md:text-[10px]">
        Duo Cleaning
      </span>
    </a>

    <nav aria-label="Primary" class="hidden md:block">
      <ul class="flex items-center gap-8 font-body text-sm text-ink">
        {
          site.nav.slice(1).map((item) => (
            <li>
              <a
                href={url(item.href)}
                aria-current={isActive(item.href) ? "page" : undefined}
                class="underline-offset-4 hover:underline aria-[current=page]:underline"
              >
                {item.label}
              </a>
            </li>
          ))
        }
        <li>
          <a
            href={url(site.primaryCta.href)}
            class="rounded-full bg-ink px-5 py-2 text-surface hover:opacity-90"
          >
            {site.primaryCta.label}
          </a>
        </li>
      </ul>
    </nav>

    <MobileNav
      client:load
      items={navItems}
      ctaLabel={site.primaryCta.label}
      ctaHref={url(site.primaryCta.href)}
    />
  </header>
</div>
