---
import { site } from "../site.config";
import { url } from "../lib/url";

const year = new Date().getFullYear();
---

<!--
  Footer content is a placeholder. The live site's footer was never filled in
  (it still reads "Your Site Title"), and no footer copy/links were supplied
  in the discovery brief. Replace the items below with real content before
  launch.
-->
<footer class="border-t border-black/10 bg-[var(--color-bg)]">
  <div class="mx-auto grid max-w-6xl gap-10 px-6 py-14 md:grid-cols-3 md:px-10">
    <div>
      <p class="font-heading text-xl">{site.name}</p>
      <p class="mt-3 max-w-xs text-sm text-black/70">
        Professional cleaning for homes, businesses, and construction sites in {site.serviceArea}.
      </p>
      <p class="mt-4 text-sm">
        {/* PLACEHOLDER: no phone number on file yet */}
        <span class="text-black/50">{site.phonePlaceholder} (placeholder)</span>
      </p>
    </div>

    <nav aria-label="Footer">
      <p class="font-body text-sm font-semibold uppercase tracking-wide text-black/60">Explore</p>
      <ul class="mt-3 space-y-2 text-sm">
        {
          site.nav.map((item) => (
            <li>
              <a href={url(item.href)} class="hover:underline">
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div>
      <p class="font-body text-sm font-semibold uppercase tracking-wide text-black/60">Follow us</p>
      <ul class="mt-3 space-y-2 text-sm">
        <li>
          <a href={site.instagramUrl} class="hover:underline">Instagram</a>
        </li>
      </ul>
      <p class="mt-6 text-xs text-black/50">
        No Google Business Profile listed yet.
      </p>
    </div>
  </div>

  <div class="border-t border-black/10 px-6 py-6 text-center text-xs text-black/50 md:px-10">
    &copy; {year} {site.name}. All rights reserved.
  </div>
</footer>
