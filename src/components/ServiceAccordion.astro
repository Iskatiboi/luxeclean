---
import type { Service } from "../site.config";

interface Props {
  services: Service[];
}

const { services } = Astro.props;
---

<!-- Native <details>/<summary> accordion: zero JS, keyboard- and screen-reader-accessible by default. -->
<div class="border-t border-black">
  {
    services.map((service) => (
      <details class="group border-b border-black">
        <summary class="flex cursor-pointer list-none items-center justify-between gap-6 py-6 font-heading text-xl md:text-2xl">
          <span>
            {service.title}
            {service.featured && (
              <span class="ml-3 align-middle font-body text-xs font-semibold uppercase tracking-wide text-black/60">
                Featured
              </span>
            )}
          </span>
          <span class="shrink-0 font-body text-2xl leading-none group-open:hidden" aria-hidden="true">
            +
          </span>
          <span class="hidden shrink-0 font-body text-2xl leading-none group-open:inline" aria-hidden="true">
            &minus;
          </span>
        </summary>
        <div class="max-w-2xl pb-6 font-body text-base leading-relaxed text-black/80">
          <p>{service.details}</p>
        </div>
      </details>
    ))
  }
</div>
