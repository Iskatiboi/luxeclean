---
import { site } from "../site.config";
import { url } from "../lib/url";

// Keyless embed. It works and needs no API key, but Google does not document this
// URL form, so its failure mode is a blank frame. If that ever happens, swap the
// src for an OpenStreetMap `export/embed.html` embed; `site.mapQuery` is the only
// other thing that would need to change.
const mapSrc = `https://www.google.com/maps?q=${encodeURIComponent(site.mapQuery)}&z=10&output=embed`;
---

<section id="service-area" class="scroll-mt-28 py-24 md:py-36">
  <div class="mx-auto max-w-6xl px-6 md:px-10">
    <div class="grid gap-12 md:grid-cols-12 md:items-center md:gap-16">
      <div class="md:col-span-5">
        <h2 data-reveal="heading" class="font-heading text-3xl md:text-5xl">Where we work</h2>
        <p data-reveal="rise" class="mt-5 max-w-md font-body leading-relaxed text-ink/75">
          Based in {site.city} and serving the surrounding towns across Central Florida.
        </p>

        <div data-reveal-group class="mt-8 flex flex-wrap gap-2.5">
          {
            site.serviceAreaCities.map((city) => (
              <span
                data-reveal-item
                class="rounded-full border border-accent/40 px-4 py-2 font-body text-sm text-ink/80"
              >
                {city}
              </span>
            ))
          }
        </div>

        <p data-reveal="rise" class="mt-8 max-w-md font-body text-sm leading-relaxed text-ink/60">
          Don't see your neighborhood? <a href={url("/contact")} class="text-ink underline">Reach out</a> anyway.
          If you are in Central Florida, we will do our best to fit you in.
        </p>
      </div>

      <div class="md:col-span-7">
        {/* The aspect ratio lives on the outer box so the lazy iframe has its space
            reserved before it loads and contributes no layout shift. */}
        <div class="relative aspect-[4/3] overflow-hidden rounded-[32px] border border-accent/30 md:aspect-[16/11]">
          <div data-reveal="frame" class="absolute inset-0">
            <iframe
              src={mapSrc}
              title={`Map of our ${site.mapQuery} service area`}
              loading="lazy"
              referrerpolicy="no-referrer-when-downgrade"
              class="block h-full w-full border-0"></iframe>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
