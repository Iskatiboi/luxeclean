---
import PlaceholderImage from "./PlaceholderImage.astro";
import PillButton from "./PillButton.astro";

interface Props {
  heading: string;
  imageLabel: string;
  ctaLabel?: string;
  ctaHref?: string;
}

const { heading, imageLabel, ctaLabel, ctaHref } = Astro.props;
---

<section class="px-6 pb-6 md:px-10">
  <div class="relative mx-auto h-[70vh] min-h-[420px] max-w-6xl overflow-hidden">
    <div class="absolute inset-0">
      <PlaceholderImage label={imageLabel} tone="dark" />
    </div>
    <!-- Dark gradient overlay for text contrast over photography -->
    <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-black/30 to-black/10" aria-hidden="true" />
    <div class="relative flex h-full flex-col items-center justify-center gap-6 px-6 text-center">
      <h1 class="max-w-3xl font-heading text-4xl text-white sm:text-5xl md:text-6xl">
        {heading}
      </h1>
      {
        ctaLabel && ctaHref && (
          <PillButton href={ctaHref} variant="inverted">
            {ctaLabel}
          </PillButton>
        )
      }
    </div>
  </div>
</section>
