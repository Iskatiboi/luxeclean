---
import PlaceholderImage from "./PlaceholderImage.astro";
import PillButton from "./PillButton.astro";

interface Props {
  eyebrow: string;
  title: string;
  description: string;
  ctaLabel: string;
  ctaHref: string;
  imageLabel: string;
}

const { eyebrow, title, description, ctaLabel, ctaHref, imageLabel } = Astro.props;
---

<div class="flex flex-col border border-black/10">
  <div class="aspect-[16/10]">
    <PlaceholderImage label={imageLabel} />
  </div>
  <div class="flex flex-1 flex-col gap-3 p-8">
    <p class="font-body text-xs font-semibold uppercase tracking-widest text-black/50">{eyebrow}</p>
    <h3 class="font-heading text-2xl">{title}</h3>
    <p class="flex-1 font-body text-black/75">{description}</p>
    <PillButton href={ctaHref} class="mt-2 self-start">{ctaLabel}</PillButton>
  </div>
</div>
