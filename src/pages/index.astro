---
import Layout from "../layouts/Layout.astro";
import Hero from "../components/Hero.astro";
import TestimonialCarousel from "../components/TestimonialCarousel.astro";
import ServiceAreaMap from "../components/ServiceAreaMap.astro";
import PillButton from "../components/PillButton.astro";
import { site } from "../site.config";
---

<Layout title="Home" hasHero>
  {/* The "Get to know us" panel lives inside Hero's curtain, which carries it up
      over the photo as the pinned sequence ends. See StoryPanel.astro. */}
  <Hero
    heading="Discover the Sparkling Side of Clean"
    subtext="Editorial-standard cleaning for homes, offices, and job sites across Greater Orlando."
    trustLine="Fully licensed and insured, so your space is protected on every visit."
    ctaLabel="Get a Free Quote"
    ctaHref="/request-a-quote"
    secondaryLabel="See Services"
    secondaryHref="/services"
    nextHeading="Now booking commercial & construction cleanup"
    servicesHeading="Explore our cleaning services"
  />

  <TestimonialCarousel />

  <ServiceAreaMap />

  <section class="bg-muted">
    <div class="mx-auto max-w-6xl px-6 py-20 text-center md:px-10 md:py-28">
      <h2
        data-reveal="heading"
        class="mx-auto max-w-2xl font-heading text-3xl leading-tight md:text-5xl"
      >
        Ready for a cleaner space?
      </h2>
      <p data-reveal="rise" class="mx-auto mt-5 max-w-lg font-body text-ink/70">
        Tell us about your space and what you need done. We will come back to you with a free quote.
      </p>
      <div data-reveal="rise" class="mt-9">
        <PillButton href={site.primaryCta.href}>{site.primaryCta.label}</PillButton>
      </div>
    </div>
  </section>
</Layout>

<script>
  import { initReveals } from "../scripts/reveal";

  initReveals();
</script>
