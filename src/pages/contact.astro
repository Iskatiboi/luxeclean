---
import Layout from "../layouts/Layout.astro";
import ContactForm from "../components/ContactForm.tsx";
import FramedPhoto from "../components/FramedPhoto.astro";
import contactImage from "../components/contact.jpg";
import { site } from "../site.config";
import { url } from "../lib/url";

// Everything a visitor might want instead of the form, answered up front.
const details = [
  { label: "Email", value: site.email, href: `mailto:${site.email}`, icon: "mail" },
  { label: "Hours", value: site.hours, icon: "clock" },
  { label: "Service area", value: `${site.city} & surrounding areas`, icon: "pin" },
] as const;
---

<Layout title="Contact" pattern="dots" description={`Contact Luxury Duo Cleaning LLC, serving ${site.serviceArea}.`}>
  <section
    class="mx-auto grid max-w-7xl gap-12 px-6 pb-20 pt-8 md:px-10 lg:grid-cols-[minmax(0,7fr)_minmax(0,5fr)] lg:gap-14 lg:pb-28 lg:pt-12"
  >
    <div class="flex flex-col gap-10">
      <header>
        <h1 class="font-heading text-4xl leading-tight md:text-5xl">Get in touch</h1>
        <p class="mt-4 max-w-lg font-body leading-relaxed text-ink/75">
          Questions about a service, scheduling, or anything else? Send us a note and we'll reply by email.
        </p>
      </header>

      {/* Email gets its own full-width row: the address is too long for a third of
          the column and broke across three lines. */}
      <ul class="grid gap-3 sm:grid-cols-2">
        {
          details.map((item) => (
            <li class:list={["flex items-start gap-3 rounded-2xl bg-surface/70 p-4 ring-1 ring-ink/5", item.icon === "mail" && "sm:col-span-2"]}>
              <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-ink text-surface" aria-hidden="true">
                <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
                  {item.icon === "mail" && (
                    <>
                      <path d="M2.5 4h11a1 1 0 0 1 1 1v6a1 1 0 0 1-1 1h-11a1 1 0 0 1-1-1V5a1 1 0 0 1 1-1Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" />
                      <path d="m1.9 5.2 6.1 4 6.1-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                    </>
                  )}
                  {item.icon === "clock" && (
                    <>
                      <circle cx="8" cy="8" r="6.2" stroke="currentColor" stroke-width="1.5" />
                      <path d="M8 4.8V8l2.2 1.4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                    </>
                  )}
                  {item.icon === "pin" && (
                    <>
                      <path d="M8 14.2s4.7-4 4.7-7.2a4.7 4.7 0 1 0-9.4 0c0 3.2 4.7 7.2 4.7 7.2Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" />
                      <path d="M8 5.4a1.6 1.6 0 1 1 0 3.2 1.6 1.6 0 0 1 0-3.2Z" stroke="currentColor" stroke-width="1.5" />
                    </>
                  )}
                </svg>
              </span>
              <span class="min-w-0">
                <span class="block font-body text-xs font-semibold uppercase tracking-[0.14em] text-ink/55">{item.label}</span>
                {"href" in item ? (
                  <a href={item.href} class="mt-1 block break-all font-body sm:break-normal text-sm text-ink underline-offset-4 hover:underline">
                    {item.value}
                  </a>
                ) : (
                  <span class="mt-1 block font-body text-sm text-ink">{item.value}</span>
                )}
              </span>
            </li>
          ))
        }
      </ul>

      <div class="@container rounded-[32px] bg-surface p-6 shadow-[0_24px_60px_rgba(23,17,13,0.08)] ring-1 ring-ink/5 md:p-10">
        <ContactForm client:load />
      </div>

      {/* Routes pricing questions to the form built for them, rather than burying
          the link mid-sentence. */}
      <a
        href={url("/request-a-quote")}
        class="group flex items-center justify-between gap-6 rounded-[24px] border border-ink/15 bg-surface/60 p-5 transition-colors hover:border-ink/40 md:p-6"
      >
        <span>
          <span class="block font-heading text-lg">Looking for a price?</span>
          <span class="mt-1 block font-body text-sm text-ink/70">
            Our quote form asks the right questions, so we can give you an accurate number.
          </span>
        </span>
        <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-ink text-surface transition-transform group-hover:translate-x-0.5" aria-hidden="true">
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
            <path d="M3.5 8h9M8.5 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </span>
      </a>
    </div>

    <FramedPhoto image={contactImage} alt="A gloved hand wiping cleaning foam across a dark stovetop, with a heart drawn in the suds" />
  </section>
</Layout>
