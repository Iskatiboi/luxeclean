---
import { Image } from "astro:assets";
import Layout from "../layouts/Layout.astro";
import PillButton from "../components/PillButton.astro";
import { site, services } from "../site.config";
import { serviceImages } from "../lib/serviceImages";
import { url } from "../lib/url";
import teamImage from "../components/team.jpg";

// Two audiences, each shown with a photo of the work and the services that fit
// them. Slugs come from site.config.ts, so titles and links never drift.
const audiences = [
  {
    title: "Homeowners & hosts",
    body: "Regular upkeep, a top-to-bottom reset, a move, or a fast turnaround between guests.",
    image: serviceImages["residential"],
    slugs: ["residential", "deep-cleaning", "move-in-move-out", "airbnb"],
  },
  {
    title: "Contractors & property managers",
    body: "Offices, storefronts, and job sites, scheduled around your project or leasing timeline.",
    image: serviceImages["commercial-construction"],
    slugs: ["commercial", "commercial-construction"],
  },
].map((a) => ({ ...a, services: a.slugs.map((slug) => services.find((s) => s.slug === slug)!).filter(Boolean) }));
---

<Layout
  title="About Us"
  pattern="circles"
  description={`Learn about Luxury Duo Cleaning LLC, a professional cleaning company serving ${site.serviceArea}.`}
>
  {/* Opening: the headline, the story, and the photo in one screen, rather than a
      lone "Who we are" heading followed by the content further down. */}
  <section class="mx-auto grid max-w-7xl items-center gap-12 lg:items-start px-6 pb-20 pt-8 md:px-10 lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] lg:gap-14 lg:pb-28 lg:pt-12">
    <div>
      <p data-reveal="rise" class="font-body text-xs font-semibold uppercase tracking-[0.2em] text-ink/55">About us</p>
      <h1 data-reveal="heading" class="mt-4 font-heading text-5xl leading-[1.05] md:text-6xl xl:text-7xl">
        Where cleanliness meets care
      </h1>
      <div data-reveal="rise" class="mt-8 max-w-lg space-y-4 font-body text-lg leading-relaxed text-ink/75">
        <p>
          At Luxury Duo Cleaning, we believe a clean space creates peace of mind. We provide reliable,
          top-quality cleaning for homes and businesses alike across {site.serviceArea}.
        </p>
        <p>
          Whether you need routine maintenance, a deep clean, a move-in/move-out turnaround, or pre- and
          post-construction cleanup, we tailor every job to fit your space and your timeline.
        </p>
        <p class="font-heading text-xl text-ink">Let us handle the mess, so you can focus on what matters most.</p>
      </div>
    </div>

    {/* The photo takes the wider share of the row. It is trimmed from 5:3 to 3:2
        for extra height, which only removes the empty wall at each side (about
        37px per side at native size); nobody in the group is cut off. */}
    {/* Top-aligned with the text on desktop: centred against the long copy column,
        the photo sank below the fold on shorter laptops. */}
    <div class="relative lg:mt-16">
      <div data-reveal="frame" class="overflow-hidden rounded-[32px] shadow-[0_30px_80px_rgba(23,17,13,0.16)]">
        <Image
          src={teamImage}
          alt="Five cleaners in aprons and blue gloves, smiling in a bright, sunlit room"
          class="aspect-[3/2] w-full object-cover object-center"
          loading="eager"
        />
      </div>
      <span
        data-reveal="rise"
        class="absolute -bottom-5 left-6 rounded-full bg-surface px-5 py-3 font-body text-sm text-ink shadow-[0_12px_30px_rgba(23,17,13,0.14)] md:left-8"
      >
        Serving {site.city} &amp; surrounding areas
      </span>
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-6 pb-24 md:px-10 lg:pb-32">
    <div class="flex flex-col gap-4 md:flex-row md:items-end md:justify-between">
      <h2 data-reveal="heading" class="font-heading text-4xl leading-tight md:text-5xl">Who we work with</h2>
      <p data-reveal="rise" class="max-w-sm font-body text-ink/70">
        Two kinds of clients, one standard. Every service below links to the details.
      </p>
    </div>

    <div data-reveal-group class="mt-12 grid gap-6 md:grid-cols-2">
      {
        audiences.map((a) => (
          <article data-reveal-item class="flex flex-col overflow-hidden rounded-[32px] bg-surface shadow-[0_24px_60px_rgba(23,17,13,0.07)] ring-1 ring-ink/5">
            <Image src={a.image} alt="" class="aspect-[16/10] w-full object-cover object-center" loading="lazy" />
            <div class="flex flex-1 flex-col p-7 md:p-9">
              <h3 class="font-heading text-2xl md:text-3xl">{a.title}</h3>
              <p class="mt-3 font-body leading-relaxed text-ink/70">{a.body}</p>
              <ul class="mt-auto flex flex-wrap gap-2 pt-7">
                {a.services.map((s) => (
                  <li>
                    <a
                      href={url(`/services#${s.slug}`)}
                      class="inline-flex items-center rounded-full border border-ink/20 px-4 py-2 font-body text-sm text-ink transition-colors hover:border-ink hover:bg-ink hover:text-surface"
                    >
                      {s.title}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          </article>
        ))
      }
    </div>
  </section>

  {/* Same dark closing band as Testimonials, running straight into the footer. */}
  <section class="bg-shade text-surface">
    <div class="mx-auto flex max-w-7xl flex-col items-start gap-10 px-6 py-20 md:px-10 md:py-28 lg:flex-row lg:items-end lg:justify-between">
      <div>
        <h2 data-reveal="heading" class="font-heading text-4xl leading-tight md:text-6xl">
          Ready to see<br />the difference?
        </h2>
        <p data-reveal="rise" class="mt-5 max-w-md font-body text-surface/75">
          Tell us about your space and we'll put together a free quote.
        </p>
      </div>
      <div data-reveal="rise" class="flex flex-wrap items-center gap-3">
        <PillButton href="/request-a-quote" variant="inverted">Request a Quote</PillButton>
        <a
          href={url("/contact")}
          class="inline-flex items-center justify-center rounded-full border border-surface/40 px-8 py-3 font-body text-sm text-surface transition-colors hover:border-surface"
        >
          Contact us
        </a>
      </div>
    </div>
  </section>
</Layout>

<script>
  import { initReveals } from "../scripts/reveal";

  initReveals();
</script>
