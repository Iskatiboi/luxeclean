---
import Layout from "../layouts/Layout.astro";
import ServiceAccordion from "../components/ServiceAccordion.astro";
import PlaceholderImage from "../components/PlaceholderImage.astro";
import PillButton from "../components/PillButton.astro";
import { services, site } from "../site.config";
---

<Layout
  title="Services"
  description={`Residential, commercial, Airbnb, move-in/move-out, deep cleaning, and construction cleanup services in ${site.serviceArea}.`}
>
  <section class="grid md:grid-cols-2">
    <div class="order-2 flex flex-col justify-center gap-5 px-6 py-14 md:order-1 md:px-14 md:py-20">
      <h1 class="font-heading text-3xl md:text-4xl">Explore our services</h1>
      <p class="max-w-md font-body text-black/80">
        Get ready to discover the sparkle in your world with cleaning services tailored to your space —
        from a single room to a full job site.
      </p>
      <ServiceAccordion services={services} />
    </div>
    <div class="order-1 md:order-2">
      <div class="aspect-[4/3] md:aspect-auto md:h-full">
        <PlaceholderImage label="services — editorial product shot" tone="light" />
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-6 pb-16 md:px-10 md:pb-24">
    <div class="flex flex-col items-start gap-4 border-t border-black pt-10 md:flex-row md:items-center md:justify-between">
      <p class="max-w-md font-heading text-2xl">Not sure which service fits? Tell us about your space.</p>
      <PillButton href="/request-a-quote">Request a Quote</PillButton>
    </div>
  </section>
</Layout>
